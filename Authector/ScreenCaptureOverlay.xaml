<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Authenticator.ScreenCaptureOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select QR Code Region">

    <Grid x:Name="RootGrid"
          Background="#80000000"
          PointerPressed="OnOverlayBackground_PointerPressed"
          PointerMoved="OnOverlayBackground_PointerMoved"
          PointerReleased="OnOverlayBackground_PointerReleased">
        <TextBlock
            Text="Click and drag to select the QR code region"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,20,0,0"
            Foreground="White"
            FontSize="16"
            IsHitTestVisible="False" />
    </Grid>
</Window>
