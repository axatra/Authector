<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Authenticator.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Password"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="300" Spacing="12">
        <TextBlock x:Name="PromptText" Text="Enter password" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
        <PasswordBox x:Name="PasswordBox" PlaceholderText="Password" />
        <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Confirm password" />
        <TextBlock x:Name="ErrorText" Text="" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="12" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
