<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Authenticator.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    CloseButtonText="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <Grid>
        <!-- Main settings content -->
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" MaxHeight="540" Margin="-24,0,-24,0">
            <StackPanel HorizontalAlignment="Stretch" Padding="32,0,32,0" Spacing="0">

                <!-- About -->
                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Authenticator" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Version 1.0.0" Opacity="0.5" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="GitHubButton" Click="GitHubButton_Click"
                            Padding="16,6">
                        <TextBlock Text="GitHub Repo" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                <!-- Settings -->
                <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Windows Hello authentication"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Require biometric or PIN to view codes"
                                       FontSize="11" Opacity="0.5"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HelloToggle" Grid.Column="1"
                                      Toggled="HelloToggle_Toggled"
                                      OnContent="On" OffContent="Off"
                                      MinWidth="0" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Hide codes by default"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Mask codes until you tap the eye icon"
                                       FontSize="11" Opacity="0.5"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HideCodesToggle" Grid.Column="1"
                                      Toggled="HideCodesToggle_Toggled"
                                      OnContent="On" OffContent="Off"
                                      MinWidth="0" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Code rotation interval"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="How often a new code is generated"
                                       FontSize="11" Opacity="0.5"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CodeStepCombo" Grid.Column="1"
                                  SelectionChanged="CodeStepCombo_SelectionChanged"
                                  MinWidth="80">
                            <ComboBoxItem Content="15s" Tag="15" />
                            <ComboBoxItem Content="20s" Tag="20" />
                            <ComboBoxItem Content="25s" Tag="25" />
                            <ComboBoxItem Content="30s" Tag="30" />
                            <ComboBoxItem Content="45s" Tag="45" />
                            <ComboBoxItem Content="60s" Tag="60" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,16" />

                <!-- Backup -->
                <TextBlock Text="Backup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Export keys"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="ExportButton" Click="ExportBackup_Click"
                                Style="{StaticResource SubtleButtonStyle}" Padding="16,6">
                            <TextBlock Text="Export" />
                        </Button>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Import keys"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="ImportButton" Click="ImportBackup_Click"
                                Style="{StaticResource SubtleButtonStyle}" Padding="16,6">
                            <TextBlock Text="Import" />
                        </Button>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Delete all accounts"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="DeleteAllButton" Click="DeleteAll_Click"
                                Style="{StaticResource SubtleButtonStyle}" Padding="16,6">
                            <TextBlock Text="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                <!-- Credits -->
                <TextBlock Text="Credits" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Developer" Opacity="0.5" FontSize="12" Grid.Column="0" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" NavigateUri="https://www.instagram.com/ehsanlax/"
                                     Content="Ehsan Hussaini" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Logo Designer" Opacity="0.5" FontSize="12" Grid.Column="0" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" NavigateUri="https://www.instagram.com/ehsanlax/"
                                     Content="Ehsan Hussaini" FontSize="12" VerticalAlignment="Center" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Delete confirmation overlay -->
        <StackPanel x:Name="DeleteConfirmPanel" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Spacing="16">
            <TextBlock Text="This action cannot be undone. All your authenticator accounts will be permanently deleted. It is recommended to export your keys before proceeding."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Cancel" Click="DeleteCancel_Click"
                        Style="{StaticResource SubtleButtonStyle}" Padding="16,6" />
                <Button Click="DeleteConfirm_Click" Padding="16,6">
                    <TextBlock Text="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
