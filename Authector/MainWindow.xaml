<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Authenticator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Authector">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar (draggable, transparent for Mica) -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="Assets/Logo.png" Width="16" Height="16" />
                <TextBlock Text="Authector" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Header row: "Your accounts" + buttons -->
        <Grid Grid.Row="1" Margin="24,8,24,12">
            <TextBlock Text="Your accounts" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="AddButton" Click="AddButton_Click" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2" Padding="24,0,24,24">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Spacing="12">
                <FontIcon Glyph="&#xE721;" FontSize="48" HorizontalAlignment="Center" Opacity="0.4" />
                <TextBlock Text="No accounts yet" FontSize="18" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="Click + to add your first authenticator account"
                           HorizontalAlignment="Center" Opacity="0.4" />
            </StackPanel>

            <!-- Account cards grid view -->
            <ScrollViewer x:Name="AccountsGridScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid x:Name="AccountsGridPanel" Margin="0,0,0,0" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
